<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="145dp"
    android:background="@color/White">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="15dp"
         android:gravity="center"
        android:id="@+id/Rl2"
        android:background="@color/White">

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:layout_below="@+id/Rl2"
        android:gravity="center"
        android:id="@+id/Rl3"
        android:background="@color/White">

        <TextView
            android:id="@+id/lblPrecio"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:text="Precio: "
            android:textColor="@color/colorPrimary"
            android:textSize="13dp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/cboPrecio"
            android:layout_width="180dp"
            android:layout_marginStart="10dp"
            android:layout_height="match_parent"></Spinner>

    </LinearLayout>

        <RelativeLayout
        android:id="@+id/Rl5"
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:layout_below="@+id/Rl3"
        android:background="@color/White"
        android:gravity="center">

        <EditText
            android:id="@+id/txtCantidad"
            android:layout_width="170dp"
            android:layout_height="match_parent"
            android:layout_marginStart="73dp"
            android:layout_marginRight="197dp"
            android:background="@drawable/rounded_edittext"
            android:hint="0"
            android:inputType="number"
            android:maxLines="1" />

        <TextView
            android:id="@+id/lblCantidad"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:text="Cantidad: "
            android:textColor="@color/colorPrimary"
            android:textSize="13dp"
            android:textStyle="bold" />
    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_below="@+id/Rl5"
        android:gravity="center"
        android:id="@+id/Rl6"
        android:background="@color/White"></RelativeLayout>

    <RelativeLayout
        android:id="@+id/Rl7"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_below="@+id/Rl6"
        android:layout_alignParentStart="true"
        android:layout_marginTop="0dp"
        android:background="@color/White"
        android:gravity="center">

        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:background="@mipmap/ic_check_circle_black_48dp"
            android:backgroundTint="#1cd100" />

        <Button
            android:id="@+id/btnCancelar"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_gravity="right"
            android:layout_marginStart="125dp"
            android:background="@mipmap/ic_cancel_black_48dp"
            android:backgroundTint="#ff0000" />

    </RelativeLayout>
</RelativeLayout>